{
  "name": "expressjs-api-produk",
  "version": "1.0.0",
  "description": "API daftar produk dengan Express.js untuk tugas Pemrograman Web",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test test.js",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --port 5555"
  },
  "type": "commonjs",
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^7.10.1"
  }
}
